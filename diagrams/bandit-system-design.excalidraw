   "boundElements": [],
   "updated": 1792828800000,
   "link": null,
   "locked": false,
   "text": "Counts the bands it hears and turns that into a green, yellow or red ring.\nIts zone is the station marker it hears loudest; a band never knows a position.\nSOS or a fall: its ring strobes red and the bands close by pulse blue.\nGuidance is the route colour, and the full bands vibrate to move people along the dispersion route.",
   "originalText": "Counts the bands it hears and turns that into a green, yellow or red ring.\nIts zone is the station marker it hears loudest; a band never knows a position.\nSOS or a fall: its ring strobes red and the bands close by pulse blue.\nGuidance is the route colour, and the full bands vibrate to move people along the dispersion route.",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
