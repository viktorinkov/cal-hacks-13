   "seed": 184777831,
   "version": 1,
   "versionNonce": 1057255845,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792828800000,
   "link": null,
   "locked": false,
   "text": "Injury happened at home: Claude says doubt, a person decides.\nWitness bands in another zone: refused at claim open as witness_zone, zones side by side.\nAmount changed while approving: fails closed as stale.\nSame bill scanned again: marked duplicate, pays nothing, refused as zero_payout.\nInjured person is venue staff: refused at claim open; workers' comp applies.\nThree or more hurt in one incident: no claim settles by rule; the organizer decides each.\nOnly code at claim open and the organizer refuse.",
   "originalText": "Injury happened at home: Claude says doubt, a person decides.\nWitness bands in another zone: refused at claim open as witness_zone, zones side by side.\nAmount changed while approving: fails closed as stale.\nSame bill scanned again: marked duplicate, pays nothing, refused as zero_payout.\nInjured person is venue staff: refused at claim open; workers' comp applies.\nThree or more hurt in one incident: no claim settles by rule; the organizer decides each.\nOnly code at claim open and the organizer refuse.",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
