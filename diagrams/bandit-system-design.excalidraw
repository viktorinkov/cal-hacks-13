   "versionNonce": 1132288064,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792828800000,
   "link": null,
   "locked": false,
   "text": "The bands are the identity during the event. Memories come only from band, zone and time; the people you see afterwards are the ones you actually spent time with. One\nrecap email brings you back.",
   "originalText": "The bands are the identity during the event. Memories come only from band, zone and time; the people you see afterwards are the ones you actually spent time with. One\nrecap email brings you back.",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
