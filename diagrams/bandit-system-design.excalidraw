  {
   "id": "te319",
   "type": "text",
   "x": 40,
   "y": 6834.0,
   "width": 2039.2,
   "height": 50.0,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "frame317",
   "roundness": null,
   "seed": 1610003953,
   "version": 1,
   "versionNonce": 130870367,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792828800000,
   "link": null,
   "locked": false,
   "text": "Elastic does the work SpacetimeDB cannot: meaning. It gets one-way copies, never live state, and sends back an organized bundle, claim checks with similar past\nclaims, and a recap order. All of it runs on Elastic Serverless.",
   "originalText": "Elastic does the work SpacetimeDB cannot: meaning. It gets one-way copies, never live state, and sends back an organized bundle, claim checks with similar past\nclaims, and a recap order. All of it runs on Elastic Serverless.",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
