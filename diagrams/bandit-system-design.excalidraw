   "updated": 1792828800000,
   "link": null,
   "locked": false,
   "text": "Live, exact state. Every write is a reducer call: one\ntransaction, all or nothing. Each change is pushed to\nevery subscribed screen. Scheduled reducers\n(watch_bands, sweep, social_tick, crowd_tick,\njob_reaper) keep it current inside the database.",
   "originalText": "Live, exact state. Every write is a reducer call: one\ntransaction, all or nothing. Each change is pushed to\nevery subscribed screen. Scheduled reducers\n(watch_bands, sweep, social_tick, crowd_tick,\njob_reaper) keep it current inside the database.",
   "fontSize": 18,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
