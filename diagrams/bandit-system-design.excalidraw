   "locked": false,
   "text": "2 \u00b7 Event data pipeline: Bright Data, then Elastic, then SpacetimeDB",
   "originalText": "2 \u00b7 Event data pipeline: Bright Data, then Elastic, then SpacetimeDB",
   "fontSize": 40,
