   "link": null,
   "locked": false,
   "text": "Edge cases, live or in the stress test",
   "originalText": "Edge cases, live or in the stress test",
   "fontSize": 22,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "te297",
   "type": "text",
   "x": 1282,
   "y": 5711.5,
   "width": 887.2,
   "height": 150.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "frame201",
   "roundness": null,
   "seed": 818417457,
   "version": 1,
   "versionNonce": 1241380032,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792828800000,
   "link": null,
   "locked": false,
   "text": "Injury happened at home: Claude says doubt, a person decides.\nWitness bands in another zone: refused, zones side by side.\nAmount changed while approving: fails closed as stale.\nSame bill scanned again: refused as a duplicate bill.\nInjured person is venue staff: refused, workers' comp applies.\nThree or more hurt in one incident: every claim goes to the adjuster.",
   "originalText": "Injury happened at home: Claude says doubt, a person decides.\nWitness bands in another zone: refused, zones side by side.\nAmount changed while approving: fails closed as stale.\nSame bill scanned again: refused as a duplicate bill.\nInjured person is venue staff: refused, workers' comp applies.\nThree or more hurt in one incident: every claim goes to the adjuster.",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
