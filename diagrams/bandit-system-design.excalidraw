  },
  {
   "id": "te467",
   "type": "text",
   "x": 2582,
   "y": 10365.5,
   "width": 1310,
   "height": 150.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "frame366",
   "roundness": null,
   "seed": 961517947,
   "version": 1,
   "versionNonce": 174758465,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792828800000,
   "link": null,
   "locked": false,
   "text": "bandit-claims plants 3 rounds of 12 genuine claims and 6 decoys (sitting down, dropped phone, fake witnesses)\nthrough the same reducers a medic uses.\nStraight-through rate per round, rising as rules are learned.\nDollars wrongly paid on decoys: target $0.\nAuto-settle precision and recall; bill-review savings; incident to payout time; human touches per claim.\nShown in the Claims tab and the Kibana dashboard BandIt claims evidence.",
   "originalText": "bandit-claims plants 3 rounds of 12 genuine claims and 6 decoys (sitting down, dropped phone, fake witnesses)\nthrough the same reducers a medic uses.\nStraight-through rate per round, rising as rules are learned.\nDollars wrongly paid on decoys: target $0.\nAuto-settle precision and recall; bill-review savings; incident to payout time; human touches per claim.\nShown in the Claims tab and the Kibana dashboard BandIt claims evidence.",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
