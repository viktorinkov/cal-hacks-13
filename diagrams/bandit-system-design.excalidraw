  {
   "id": "te513",
   "type": "text",
   "x": 62,
   "y": 11920.0,
   "width": 1616.8,
   "height": 75.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
