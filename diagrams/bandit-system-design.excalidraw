   "versionNonce": 924235811,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792828800000,
   "link": null,
   "locked": false,
   "text": "SpacetimeDB holds the live, exact state and every write. The Evidence Engine, built on Elastic, validates, organizes and ranks by meaning. The Decision Engine, Claude\nagents plus code, makes the claim decisions. Bright Data scrapes the web before the event. Nessie moves the money.",
   "originalText": "SpacetimeDB holds the live, exact state and every write. The Evidence Engine, built on Elastic, validates, organizes and ranks by meaning. The Decision Engine, Claude\nagents plus code, makes the claim decisions. Bright Data scrapes the web before the event. Nessie moves the money.",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
