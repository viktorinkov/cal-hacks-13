  },
  {
   "id": "te300",
   "type": "text",
   "x": 2582,
   "y": 5711.5,
   "width": 1310,
   "height": 150.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "frame201",
   "roundness": null,
   "seed": 1228144680,
   "version": 1,
   "versionNonce": 1102205829,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792828800000,
   "link": null,
   "locked": false,
   "text": "bandit-sim plants 3 rounds of 12 genuine claims and 6 decoys (sitting down, dropped phone, fake witnesses) through\nthe same reducers a medic uses.\nStraight-through rate per round, rising as rules are learned.\nDollars wrongly paid on decoys: target $0.\nAuto-settle precision and recall; bill-review savings; incident to payout time; human touches per claim.\nShown in the Claims queue and the Kibana claims dashboard.",
   "originalText": "bandit-sim plants 3 rounds of 12 genuine claims and 6 decoys (sitting down, dropped phone, fake witnesses) through\nthe same reducers a medic uses.\nStraight-through rate per round, rising as rules are learned.\nDollars wrongly paid on decoys: target $0.\nAuto-settle precision and recall; bill-review savings; incident to payout time; human touches per claim.\nShown in the Claims queue and the Kibana claims dashboard.",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
