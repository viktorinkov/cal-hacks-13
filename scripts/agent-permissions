def merge(current, ours):
    kept = [rule for rule in current if "CalHacks 13.0" not in rule]
    if "$defaults" not in kept:
        kept.insert(0, "$defaults")
    return kept + ours


backup = f"{PATH}.bak.{time.strftime('%Y%m%d%H%M%S')}"
shutil.copy2(PATH, backup)
settings = json.load(open(PATH))
auto = settings.setdefault("autoMode", {})
auto["environment"] = merge(auto.get("environment", []), ENVIRONMENT)
auto["allow"] = merge(auto.get("allow", []), ALLOW)

tmp = PATH + ".tmp"
with open(tmp, "w") as f:
    json.dump(settings, f, indent=2)
    f.write("\n")
shutil.copymode(backup, tmp)
os.replace(tmp, PATH)
print(f"Auto mode rules for CalHacks 13.0 are updated. Backup: {backup}")
