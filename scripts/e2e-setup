#!/bin/sh
# After scripts/e2e-publish: load the event (local only), the merch templates, the insurance actors and
# the services' identities, grant their roles, and start the safety watch, the job reaper and the crowd.
set -e
. "$(dirname "$0")/e2e-env"
cd "$ROOT"
cargo build -q -p bandit-claims -p bandit-api -p bandit-indexer -p bandit-workers
DB="$SPACETIMEDB_DATABASE"
call() { stdb call -s "$STDB_SERVER" "$DB" "$@" 2>&1 | grep -v UNSTABLE || true; }

# The event: the newest assembled CalHacks bundle, else the small dev seed.
BUNDLE="${E2E_BUNDLE:-$(ls -t crates/bandit-ingest/events/calhacks-13/bundles/*.json 2>/dev/null | grep -v organized | head -1)}"
if [ -z "$BUNDLE" ]; then BUNDLE=scripts/e2e/bundle.json; fi
if [ "$E2E_TARGET" = local ] || [ -n "$E2E_BUNDLE" ]; then
  echo "event      $BUNDLE"
  call import_event "$(python3 -c 'import json,sys; b=json.load(open(sys.argv[1])); print(json.dumps(b[0] if isinstance(b, list) else b))' "$BUNDLE")"
fi

# Merch: the templates in assets/merch, matched to the sponsors' booths.
scripts/merch-setup

# Insurance: actors, roles, policy, authority matrix, camera, test bands and the four attendees.
./target/debug/bandit-claims setup

# Identities for the services and the photographer, saved in the same token store.
identity() {
  file="$DATA/identities/$1"
  if [ ! -s "$file" ]; then
    mkdir -p "$DATA/identities" && chmod 700 "$DATA/identities"
    curl -s -X POST "$SPACETIMEDB_URL/v1/identity" | python3 -c 'import json,sys; print(json.load(sys.stdin)["token"])' > "$file"
    chmod 600 "$file"
  fi
  python3 - "$file" <<'PY'
import base64, json, sys
token = open(sys.argv[1]).read().strip()
claims = json.loads(base64.urlsafe_b64decode(token.split(".")[1] + "=="))
print(claims["hex_identity"])
PY
}
for spec in bandit-api:api:bandit-api bandit-indexer:indexer:bandit-indexer photographer:photographer:Photographer; do
  name="${spec%%:*}"; rest="${spec#*:}"; role="${rest%%:*}"; label="${rest#*:}"
  id="$(identity "$name")"
  call grant_role "\"0x$id\"" "\"$role\"" "\"$label\""
  echo "$name $(echo "$id" | cut -c1-12)  $role"
done

call start_safety_watch
call start_job_reaper
call start_crowd 1000
echo "e2e ready on $E2E_TARGET: run scripts/e2e-services, then open http://$BANDIT_API_ADDR/organizer"
