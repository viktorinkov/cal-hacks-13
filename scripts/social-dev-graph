#!/usr/bin/env python3
"""Serve a live view of the people graph from the local social dev database at http://127.0.0.1:8095.

The page polls /graph.json every 2 s. This server reads people_link, attendees, booths and companies
through SpacetimeDB's SQL endpoint with the local owner token, which never reaches the browser.
"""
import http.server
import json
import pathlib
import re
import urllib.request

ROOT = pathlib.Path(__file__).resolve().parent.parent
PAGE = ROOT / "scripts" / "social-dev" / "graph.html"
SQL_URL = "http://127.0.0.1:3091/v1/database/bandit-social-dev/sql"
TOKEN = re.search(r'spacetimedb_token\s*=\s*"([^"]+)"', (ROOT / ".dev/stdb-config/cli.toml").read_text()).group(1)


def sql(query):
    req = urllib.request.Request(SQL_URL, data=query.encode(), headers={"Authorization": f"Bearer {TOKEN}"})
    with urllib.request.urlopen(req, timeout=5) as resp:
        result = json.load(resp)[0]
    cols = [e["name"]["some"] for e in result["schema"]["elements"]]
    return [dict(zip(cols, row)) for row in result["rows"]]


def graph():
    people = {a["node_id"]: a for a in sql("SELECT node_id, display_name, photo_url, simulated FROM attendee WHERE findable = true")}
    booths = {b["id"]: b["name"] for b in sql("SELECT id, name FROM booth")}
    companies = {o["id"]: o["name"] for o in sql("SELECT id, name FROM organization")}
    links = sql("SELECT key, kind, from_kind, from_id, to_kind, to_id, weight FROM people_link")

    def node(kind, id_):
        if kind == "person":
            p = people.get(id_, {})
            return {"id": f"person:{id_}", "kind": kind, "label": p.get("display_name", "someone"), "image": p.get("photo_url", "")}
        names = booths if kind == "booth" else companies
        return {"id": f"{kind}:{id_}", "kind": kind, "label": names.get(id_, kind)}

    nodes = {}
    edges = []
    for l in links:
        a, b = node(l["from_kind"], l["from_id"]), node(l["to_kind"], l["to_id"])
        nodes[a["id"]], nodes[b["id"]] = a, b
        edges.append({"id": l["key"], "from": a["id"], "to": b["id"], "kind": l["kind"], "weight": l["weight"]})
    return {"nodes": list(nodes.values()), "edges": edges}


class Handler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/graph.json":
            body, kind = json.dumps(graph()).encode(), "application/json"
        else:
            body, kind = PAGE.read_bytes(), "text/html; charset=utf-8"
        self.send_response(200)
        self.send_header("Content-Type", kind)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *args):
        pass


if __name__ == "__main__":
    print("people graph on http://127.0.0.1:8095")
    http.server.ThreadingHTTPServer(("127.0.0.1", 8095), Handler).serve_forever()
