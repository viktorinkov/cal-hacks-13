#!/bin/sh
# Build the merged module and publish it. E2E_TARGET=local (default) wipes the local database;
# E2E_TARGET=maincloud updates the live database in place and keeps its data.
set -e
. "$(dirname "$0")/e2e-env"
cd "$ROOT"
(cd spacetimedb/server && cargo build -q --release --target wasm32-unknown-unknown)
WASM=target/wasm32-unknown-unknown/release/band1t.wasm
DB="$SPACETIMEDB_DATABASE"

if [ "$E2E_TARGET" = local ]; then
  stdb server add --url "$SPACETIMEDB_URL" "$STDB_SERVER" --no-fingerprint >/dev/null 2>&1 || true
  grep -q spacetimedb_token "$DATA/spacetime/cli.toml" 2>/dev/null || stdb login --server-issued-login "$STDB_SERVER" >/dev/null
  rm -rf "$DATA/identities" "$DATA/blobs" "$DATA/records"
  stdb publish --bin-path "$WASM" -s "$STDB_SERVER" -y --delete-data "$DB"
else
  stdb publish --bin-path "$WASM" -s "$STDB_SERVER" -y "$DB"
fi

# Existing rule approvals retain their wording. Flag legacy scopes and offer fresh approvals.
stdb call -s "$STDB_SERVER" "$DB" review_rule_scopes
