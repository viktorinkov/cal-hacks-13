#!/bin/sh
# Build the web pages and run bandit-api (pages and API on $BANDIT_API_ADDR), bandit-indexer and
# bandit-workers against the E2E_TARGET database. Logs go to .dev/e2e-<target>/logs. Stop with Ctrl-C.
set -e
. "$(dirname "$0")/e2e-env"
cd "$ROOT"
export BANDIT_DEMO="${BANDIT_DEMO:-1}"
(cd web && bun install --silent && bun run --silent build >/dev/null)
cargo build -q -p bandit-api -p bandit-indexer -p bandit-workers
mkdir -p "$DATA/logs"
"$CARGO_TARGET_DIR/debug/bandit-indexer" > "$DATA/logs/indexer.log" 2>&1 &
"$CARGO_TARGET_DIR/debug/bandit-workers" > "$DATA/logs/workers.log" 2>&1 &
"$CARGO_TARGET_DIR/debug/bandit-api" > "$DATA/logs/api.log" 2>&1 &
trap 'kill $(jobs -p) 2>/dev/null' INT TERM EXIT
echo "pages on http://$BANDIT_API_ADDR (host portal: /organizer), logs in $DATA/logs"
wait
