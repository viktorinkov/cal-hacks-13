#!/bin/sh
# Deploy BandIt to the Vultr server at <ip> (Debian, root over SSH): copies the service keys from .env, the
# module owner's token and the Maincloud identities straight to the server, then runs deploy/setup.sh there,
# which builds $BANDIT_BRANCH (default vik-deploy) and serves it on https://<ip with dashes>.sslip.io.
# Run it again to update the server.
set -e
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
IP="$1"
[ -n "$IP" ] || { echo "usage: scripts/deploy-vultr <server-ip>" >&2; exit 2; }
ENV_FILE="${ENV_FILE:-$ROOT/.env}"
IDENTITIES="${IDENTITIES:-$ROOT/.dev/e2e-maincloud/identities}"
BRANCH="${BANDIT_BRANCH:-vik-deploy}"
HOST="$(echo "$IP" | tr . -).sslip.io"
SSH="ssh -o StrictHostKeyChecking=accept-new root@$IP"

{
  grep -E '^(SPACETIMEDB_URL|SPACETIMEDB_DATABASE|NESSIE_BASE_URL|NESSIE_API_KEY|ELASTICSEARCH_URL|ELASTICSEARCH_API_KEY|KIBANA_URL|ANTHROPIC_API_KEY|ANTHROPIC_MODEL)=' "$ENV_FILE"
  printf 'BANDIT_OWNER_TOKEN=%s\n' "$(sed -n 's/^spacetimedb_token *= *"\(.*\)"/\1/p' "$HOME/.config/spacetime/cli.toml")"
} | $SSH 'install -d -m 700 /opt/bandit && umask 077 && cat > /opt/bandit/.env'
COPYFILE_DISABLE=1 tar --no-xattrs -C "$IDENTITIES" -cz . \
  | $SSH 'install -d -m 700 /var/lib/bandit/identities && tar -xzo -C /var/lib/bandit/identities && chmod 600 /var/lib/bandit/identities/*'
$SSH "BANDIT_BRANCH=$BRANCH BANDIT_HOST=$HOST bash -s" < "$ROOT/deploy/setup.sh"
echo "BandIt is live on https://$HOST (organizer: https://$HOST/organizer)"
