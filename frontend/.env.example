# mock (default): everything runs in the browser, deterministic, labelled SIMULATION
# live: talk to the Rust backend below
VITE_BANDIT_MODE=mock
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/v1/stream
# local: keep the in-browser simulated crowd while bands and incidents are live (hybrid)
# backend: expect the backend to stream crowd entities
VITE_BANDIT_CROWD=local
# 1 if the backend exposes the /v1/demo/* presentation endpoints
VITE_BANDIT_DEMO_API=0
# Claims, medical cards, and the wallet. Maincloud holds the hackathon database.
VITE_SPACETIMEDB_URI=https://maincloud.spacetimedb.com
VITE_SPACETIMEDB_DB=bandit-calhacks13-sp82j
