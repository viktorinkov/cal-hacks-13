#!/bin/sh
# Rejects commit and merge messages that point at Claude or Codex (claude/ and codex/ branch names, claude.ai
# and chatgpt.com links, Claude-Session and Co-Authored-By trailers) and commits authored as either.
# .claude/hooks/git-hooks turns this on with core.hooksPath at session start.
bad="$(grep -v '^#' "$1" | grep -inE '(^|[^.])(claude|codex)/|claude\.(ai|com)|chatgpt\.com|claude-session|co-authored-by:.*(claude|anthropic|codex|openai|chatgpt)|generated (with|by).*(claude|codex|chatgpt)|anthropic\.com|openai\.com')"
author="$(git var GIT_AUTHOR_IDENT 2>/dev/null)"
case "$author" in
  Claude\ * | Codex\ * | *anthropic.com* | *openai.com*) bad="${bad:+$bad
}author: $author" ;;
esac
[ -z "$bad" ] && exit 0

cat >&2 <<MSG
Commit rejected: the message or author points at Claude or Codex.
$bad

Write one short line that says what the change does, with no AI branch names, links or trailers.
For a merge: git merge -m "merge <what it brings>" <branch>
If a merge stopped here, finish it with: git commit -m "merge <what it brings>"
If the author is Claude or Codex: git config user.name "Viktor Minchev"; git config user.email vikitominchev@gmail.com
MSG
exit 1
